@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>EliteCar Login</title>

    <link href="~/css/account.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

</head>

<body>

<div class="account-page">

    <div class="account-left">

        <div class="overlay">

            <div class="brand-box">

                <i class="fa-solid fa-car-side brand-icon"></i>

                <h1>EliteCar</h1>

                <p>
                    Premium Car Rental Experience
                </p>

            </div>

        </div>

    </div>

    <div class="account-right">

        <div class="account-card">

            <div class="login-logo">

                <i class="fa fa-car"></i>

            </div>

            <h2>
                Welcome Back
            </h2>

            <p class="subtitle">
                Sign in to continue
            </p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">

                    @ViewBag.Error

                </div>
            }

            <form asp-action="Login"
                  asp-controller="Account"
                  method="post">

                <div class="mb-4">

                    <label>
                        Login As
                    </label>

                    <div class="role-selection">

                        <button type="button"
                                class="role-btn active-role"
                                onclick="selectRole('Admin',this)">

                            Admin

                        </button>

                        <button type="button"
                                class="role-btn"
                                onclick="selectRole('User',this)">

                            User

                        </button>

                    </div>

                    <input type="hidden"
                           id="role"
                           name="role"
                           value="Admin" />

                </div>

                <div class="mb-3">

                    <label>Email</label>

                    <div class="input-wrapper">

                        <i class="fa fa-envelope"></i>

                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="Enter Email"
                               required />

                    </div>

                </div>

                <div class="mb-3">

                    <label>Password</label>

                    <div class="input-wrapper">

                        <i class="fa fa-lock"></i>

                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control"
                               placeholder="Enter Password"
                               required />

                        <span class="eye-icon"
                              onclick="togglePassword()">

                            <i class="fa fa-eye"></i>

                        </span>

                    </div>

                </div>

                <div class="remember-row">

                    <label>

                        <input type="checkbox" />

                        Remember Me

                    </label>

                    <a href="#">

                        Forgot Password?

                    </a>

                </div>

                <button type="submit"
                        class="main-btn">

                    Login

                </button>

                <div class="account-link">

                    <a href="/Account/Register">

                        Create New Account

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<script src="~/js/account.js"></script>

</body>
</html>