<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EliteCar Premium Rental</title>

    <!-- Bootstrap 5 & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>

    <!-- ==========================
            LUXURY NAVBAR
    =========================== -->
    <nav class="landing-navbar">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between">
                
                <!-- Brand Logo -->
                <a class="landing-brand" href="/">
                    <div class="brand-icon-box">
                        <i class="fa fa-car"></i>
                    </div>
                    <div class="brand-text">
                        Elite<span>Car</span>
                    </div>
                </a>

                <!-- Nav Links -->
                <div class="d-none d-lg-flex align-items-center gap-1">
                    <a href="/" class="nav-link-custom">Home</a>
                    <a href="/User/Index" class="nav-link-custom">Rental Cars</a>
                    <a href="#features" class="nav-link-custom">Why EliteCar</a>
                    <a href="#howitworks" class="nav-link-custom">How It Works</a>
                    <a href="#contact" class="nav-link-custom">Contact</a>
                </div>

                <!-- Auth Buttons -->
                <div class="d-flex align-items-center gap-3">
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        var role = Context.Session.GetString("Role");
                        var dashUrl = role == "Admin" ? "/Admin/Dashboard" : "/User/Index";
                        <a href="@dashUrl" class="btn-landing-cta">
                            <i class="fa fa-gauge"></i> Go to Dashboard
                        </a>
                        <a href="/Account/Logout" class="btn-landing-login">
                            <i class="fa fa-sign-out-alt"></i> Logout
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn-landing-login">
                            <i class="fa fa-right-to-bracket me-1"></i> Sign In
                        </a>
                        <a href="/Account/Register" class="btn-landing-cta">
                            <i class="fa fa-user-plus me-1"></i> Register
                        </a>
                    }
                </div>

            </div>
        </div>
    </nav>

    <!-- MAIN BODY -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ==========================
            LUXURY FOOTER
    =========================== -->
    <footer class="landing-footer" id="contact">
        <div class="container">
            <div class="row g-4">
                
                <div class="col-lg-4 col-md-6 footer-brand">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-box" style="width:36px; height:36px; font-size:16px;">
                            <i class="fa fa-car"></i>
                        </div>
                        <h3 class="mb-0">Elite<span style="color:#2563eb;">Car</span></h3>
                    </div>
                    <p>
                        EliteCar is India's premier car rental experience. Enjoy high-performance luxury sedans, sports cars, and SUVs with instant online approval and contactless pickup.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-secondary fs-5"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-secondary fs-5"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-secondary fs-5"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#" class="text-secondary fs-5"><i class="fa-brands fa-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6 footer-col">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/User/Index">Browse Rental Cars</a></li>
                        <li><a href="#howitworks">How It Works</a></li>
                        <li><a href="#features">Key Features</a></li>
                        <li><a href="/Account/Login">Client Login</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 col-6 footer-col">
                    <h5>Categories</h5>
                    <ul class="footer-links">
                        <li><a href="/User/Index">Luxury Sedans</a></li>
                        <li><a href="/User/Index">Executive SUVs</a></li>
                        <li><a href="/User/Index">Sports Cars</a></li>
                        <li><a href="/User/Index">Electric Vehicles</a></li>
                        <li><a href="/User/Index">Special Occasions</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-col">
                    <h5>Hub & Support</h5>
                    <ul class="footer-links">
                        <li><i class="fa fa-location-dot me-2 text-primary"></i> 100 Ft Road, Indiranagar, Bengaluru, KA</li>
                        <li><i class="fa fa-phone me-2 text-primary"></i> +91 (800) 123-4567</li>
                        <li><i class="fa fa-envelope me-2 text-primary"></i> support@elitecar.com</li>
                        <li><i class="fa fa-clock me-2 text-primary"></i> 24/7 Roadside Assistance & Booking</li>
                    </ul>
                </div>

            </div>

            <div class="footer-bottom">
                <div>
                    &copy; @DateTime.Now.Year EliteCar Rental Systems Pvt Ltd. All rights reserved.
                </div>
                <div class="d-flex gap-3">
                    <a href="/Home/Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
                    <span class="text-secondary">•</span>
                    <a href="#" class="text-secondary text-decoration-none">Terms of Service</a>
                    <span class="text-secondary">•</span>
                    <a href="#" class="text-secondary text-decoration-none">Security</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
