<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>EliteCar</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          rel="stylesheet" />

    <link href="~/css/userlayout.css"
          rel="stylesheet"
          asp-append-version="true" />

</head>

<body>

    <div class="main-container">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div>

                <div class="brand-section">

                    <h2 class="logo">

                        <i class="fa fa-car"></i>

                        EliteCar

                    </h2>

                    <p class="brand-subtitle">

                        Premium Car Rental

                    </p>

                </div>

                <hr />

                <a href="/User/Index"
                   class="menu-link">

                    <i class="fa fa-car"></i>

                    Dashboard

                </a>

                <a href="/User/MyBookings"
                   class="menu-link">

                    <i class="fa fa-calendar-check"></i>

                    My Bookings

                </a>

                <a href="/User/Verification"
                   class="menu-link">

                    <i class="fa fa-id-card"></i>

                    Verification

                </a>

            </div>

            <div>

                <a href="/User/Profile" class="user-card">

                    @if (ViewBag.ProfileImage != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String((byte[])ViewBag.ProfileImage)"
                             class="sidebar-profile-img" />
                    }
                    else
                    {
                        <img src="~/images/default-user.png"
                             class="sidebar-profile-img" />
                    }

                    <div class="user-details">

                        <strong>

                            @Context.Session.GetString("Name")

                        </strong>

                        <small>

                            Customer

                        </small>

                    </div>

                    <i class="fa fa-chevron-right profile-arrow"></i>

                </a>
                
                <a href="/Account/Logout"
                   class="logout-btn">

                    <i class="fa fa-sign-out-alt"></i>

                    Logout

                </a>

            </div>

        </aside>

        <!-- TOPBAR -->
        <div class="topbar">

            <h4>

                EliteCar Rental

            </h4>

            <div class="profile-dropdown">

                <button class="profile-btn">

                    @if (ViewBag.ProfileImage != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String((byte[])ViewBag.ProfileImage)"
                             class="profile-avatar-img" />
                    }
                    else
                    {
                        <img src="~/images/default-user.png"
                             class="profile-avatar-img" />
                    }

                    <span>
                        @Context.Session.GetString("Name")
                    </span>

                    <i class="fa fa-angle-down"></i>

                </button>

                <div class="profile-menu">

                    <div class="profile-header">

                        @if (ViewBag.ProfileImage != null)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String((byte[])ViewBag.ProfileImage)"
                                 class="top-profile-img" />
                        }
                        else
                        {
                            <img src="~/images/default-user.png"
                                 class="top-profile-img" />
                        }
                        <div>

                            <strong>
                                @Context.Session.GetString("Name")
                            </strong>

                            <small>
                                Customer
                            </small>

                        </div>

                    </div>

                    <hr />

                    <a href="/User/Profile">

                        <i class="fa fa-user"></i>

                        My Profile

                    </a>

                    <a href="/Account/Logout">

                        <i class="fa fa-sign-out-alt"></i>

                        Logout

                    </a>

                </div>

            </div>

        </div>

        <!-- CONTENT -->

        <main class="content-area">

            @RenderBody()

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>